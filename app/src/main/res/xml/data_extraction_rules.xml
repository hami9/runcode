<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude-only ruleset: everything not listed here is still transferred.
    The vault SharedPreferences must never leave the device in either flow.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="runcode_vault.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="projects/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="runcode_vault.xml" />
    </device-transfer>
</data-extraction-rules>
